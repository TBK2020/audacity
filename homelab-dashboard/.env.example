# labdeck 环境变量模板
# 用法: cp .env.example .env 然后填写。.env 已被 .gitignore 忽略，不会进 git。
# run-apple-container.sh 和 docker compose 都会自动加载同目录的 .env，
# 并把这些变量原样传进容器（services.yaml 里的 ${VAR} 引用由 labdeck 进程展开）。

# ── 面板 ─────────────────────────────────────────────
# Web 界面 HTTP Basic 认证密码（用户名任意）。留空 = 不启用认证，仅建议内网测试用
LABDECK_PASSWORD=

# WebSSH 凭据库的加密主密钥（一段足够长的随机口令）。
# 丢失后凭据库无法解密；不设置则 SSH 功能禁用
LABDECK_MASTER_KEY=

# 终端 TOTP 二次确认密钥（labdeck -gen-totp 生成）。配合 ssh.require_totp: true
LABDECK_TOTP=

# ── 通知 ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 集成凭据（services.yaml 中以 ${VAR} 引用）──────────
# Proxmox API Token 的 Secret（token_id 写在 services.yaml 里）
PVE_TOKEN=
# ESXi 只读账号密码
ESXI_PASS=

# ── 构建/网络（仅 run-apple-container.sh 使用）─────────
# 自定义镜像源域名，置顶于内置国内源列表之前
REGISTRY_MIRROR=
# container build 超时秒数（默认 300）
BUILD_TIMEOUT=
